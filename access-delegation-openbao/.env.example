# A GitHub OAuth App — https://github.com/settings/developers
#
# Register one with the callback URL below, then copy this file to .env and
# fill in the two values. The demo needs a real OAuth App because the whole
# point is a token that belongs to a *person*, which only three-legged OAuth
# produces.
#
#   Authorization callback URL: http://127.0.0.1:8765/callback
#
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# Host ports. Override if something already occupies one of these.
#BAO_PORT=8200
#KEYCLOAK_PORT=8080
#WARDEN_PORT=8400
# Must match the OAuth App's registered callback URL.
#ENROLL_PORT=8765
